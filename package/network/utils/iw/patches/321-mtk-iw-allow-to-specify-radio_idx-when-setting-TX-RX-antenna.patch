From 703cf2f5ff2e5063d8cd31179f82adf3a8474992 Mon Sep 17 00:00:00 2001
From: Michael-CY Lee <michael-cy.lee@mediatek.com>
Date: Tue, 28 Oct 2025 13:47:31 +0800
Subject: [PATCH 17/17] mtk: iw: allow to specify radio_idx when setting TX/RX
 antenna

Signed-off-by: Michael-CY Lee <michael-cy.lee@mediatek.com>
Link: https://github.com/mediatek/mtk-openwrt-feeds/blob/22213a321b6dafb2a5e01def97363420e6e938fd/autobuild/unified/filogic/mac80211/25.12/files/package/network/utils/iw/patches/0010-mtk-iw-allow-to-specify-radio_idx-when-setting-TX-RX.patch
Signed-off-by: Paul-Louis Charrière <plcharriere@gmail.com>
---
 phy.c | 38 ++++++++++++++++++++++++++++++++++++--
 1 file changed, 36 insertions(+), 2 deletions(-)

--- a/phy.c
+++ b/phy.c
@@ -776,9 +776,18 @@ static int handle_antenna(struct nl80211
 	char *end;
 	uint32_t tx_ant = 0, rx_ant = 0;
 
-	if (argc == 1 && strcmp(argv[0], "all") == 0) {
+	if ((argc == 1 || argc == 3) && strcmp(argv[0], "all") == 0) {
 		tx_ant = 0xffffffff;
 		rx_ant = 0xffffffff;
+
+		if (argc == 3 && strcmp(argv[1], "radio") == 0) {
+			unsigned int radio_idx = strtoul(argv[2], &end, 0);
+
+			if (*end)
+				return 1;
+
+			NLA_PUT_U8(msg, NL80211_ATTR_WIPHY_RADIO_INDEX, radio_idx);
+		}
 	} else if (argc == 1) {
 		tx_ant = rx_ant = strtoul(argv[0], &end, 0);
 		if (*end)
@@ -791,6 +800,31 @@ static int handle_antenna(struct nl80211
 		rx_ant = strtoul(argv[1], &end, 0);
 		if (*end)
 			return 1;
+	} else if (argc == 3 && strcmp(argv[1], "radio") == 0) {
+		unsigned int radio_idx = strtoul(argv[2], &end, 0);
+
+		if (*end)
+			return 1;
+
+		tx_ant = rx_ant = strtoul(argv[0], &end, 0);
+		if (*end)
+			return 1;
+
+		NLA_PUT_U8(msg, NL80211_ATTR_WIPHY_RADIO_INDEX, radio_idx);
+	} else if (argc == 4 && strcmp(argv[2], "radio") == 0) {
+		unsigned int radio_idx = strtoul(argv[3], &end, 0);
+
+		if (*end)
+			return 1;
+
+		tx_ant = strtoul(argv[0], &end, 0);
+		if (*end)
+			return 1;
+		rx_ant = strtoul(argv[1], &end, 0);
+		if (*end)
+			return 1;
+
+		NLA_PUT_U8(msg, NL80211_ATTR_WIPHY_RADIO_INDEX, radio_idx);
 	} else
 		return 1;
 
@@ -802,7 +836,7 @@ static int handle_antenna(struct nl80211
  nla_put_failure:
 	return -ENOBUFS;
 }
-COMMAND(set, antenna, "<bitmap> | all | <tx bitmap> <rx bitmap>",
+COMMAND(set, antenna, "<bitmap> [radio <radio_idx>] | all [radio <radio_idx>] | <tx bitmap> <rx bitmap> [radio <radio_idx>]",
 	NL80211_CMD_SET_WIPHY, 0, CIB_PHY, handle_antenna,
 	"Set a bitmap of allowed antennas to use for TX and RX.\n"
 	"The driver may reject antenna configurations it cannot support.");

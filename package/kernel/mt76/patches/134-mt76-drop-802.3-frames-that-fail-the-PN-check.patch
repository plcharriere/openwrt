From: Paul-Louis Charrière <plcharriere@gmail.com>
Date: Thu, 15 Oct 2026 09:04:22 +0900
Subject: [PATCH] wifi: mt76: drop 802.3 frames that fail the PN check

mt76 marks a received frame RX_FLAG_ONLY_MONITOR when its CCMP PN is not
above the last PN of its TID, and the drivers mark frames with an ICV or
MIC error the same way. mac80211 drops such frames in its monitor step,
which it runs for 802.11 frames only. Frames the hardware converted to
802.3 skip it and are delivered like any other frame: a retransmission
that reaches the host twice is received twice.

Drop 802.3 frames marked RX_FLAG_ONLY_MONITOR in mt76_rx_complete().

With WED or an NPU, mt76 does not reorder in software, and the hardware
reordering does not cover every block-ack session: the mt7996 hardware
takes no session with a window smaller than 64 frames, which some
clients use for some TIDs. A frame of such a session that is
retransmitted after later ones arrives with an older PN and is no
replay. Keep delivering those frames, so that a repeat of the last
frame, and a frame with an older PN outside a block-ack session, are
dropped.

Fixes: 3c1032e12217 ("mt76: allow receiving frames with invalid CCMP PN via monitor interfaces")
Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Paul-Louis Charrière <plcharriere@gmail.com>
---
--- a/mac80211.c
+++ b/mac80211.c
@@ -1323,8 +1323,20 @@ mt76_rx_convert(struct mt76_dev *dev, st
 	*hw = mt76_phy_hw(dev, mstat.phy_idx);
 }
 
+static bool
+mt76_rx_ba_session(struct mt76_wcid *wcid, int tidno)
+{
+	if (tidno >= ARRAY_SIZE(wcid->aggr))
+		return false;
+
+	if (wcid->def_wcid)
+		wcid = wcid->def_wcid;
+
+	return !!rcu_access_pointer(wcid->aggr[tidno]);
+}
+
 static void
-mt76_check_ccmp_pn(struct sk_buff *skb)
+mt76_check_ccmp_pn(struct mt76_dev *dev, struct sk_buff *skb)
 {
 	struct mt76_rx_status *status = (struct mt76_rx_status *)skb->cb;
 	struct mt76_wcid *wcid = status->wcid;
@@ -1370,6 +1382,17 @@ skip_hdr_check:
 	BUILD_BUG_ON(sizeof(status->iv) != sizeof(wcid->rx_key_pn[0]));
 	ret = memcmp(status->iv, wcid->rx_key_pn[security_idx],
 		     sizeof(status->iv));
+
+	/* Without software reordering, a frame of a block-ack session
+	 * that the hardware does not reorder can arrive after later ones
+	 * when it is retransmitted: an older PN is then no replay
+	 */
+	if (ret < 0 && (status->flag & RX_FLAG_8023) &&
+	    (mtk_wed_device_active(&dev->mmio.wed) ||
+	     mt76_npu_device_active(dev)) &&
+	    mt76_rx_ba_session(wcid, security_idx))
+		return;
+
 	if (ret <= 0) {
 		status->flag |= RX_FLAG_ONLY_MONITOR;
 		return;
@@ -1552,9 +1575,20 @@ void mt76_rx_complete(struct mt76_dev *d
 
 	spin_lock(&dev->rx_lock);
 	while ((skb = __skb_dequeue(frames)) != NULL) {
+		struct mt76_rx_status *status = (struct mt76_rx_status *)skb->cb;
 		struct sk_buff *nskb = skb_shinfo(skb)->frag_list;
 
-		mt76_check_ccmp_pn(skb);
+		mt76_check_ccmp_pn(dev, skb);
+
+		/* mac80211 passes 802.3 frames to no monitor interface and
+		 * ignores RX_FLAG_ONLY_MONITOR for them
+		 */
+		if ((status->flag & RX_FLAG_8023) &&
+		    (status->flag & RX_FLAG_ONLY_MONITOR)) {
+			dev_kfree_skb(skb);
+			continue;
+		}
+
 		skb_shinfo(skb)->frag_list = NULL;
 		mt76_rx_convert(dev, skb, &hw, &sta);
 		ieee80211_rx_list(hw, sta, skb, &list);

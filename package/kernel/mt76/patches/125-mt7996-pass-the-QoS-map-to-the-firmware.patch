+void mt7996_mcu_fill_qos_map(struct mt7996_vif *mvif,
+			     struct cfg80211_qos_map *usr_qos_map)
+{
+	u8 *map = mvif->qos_map;
+	int i;
+
+	/* Default QoS map, defined in section 2.3 of RFC8325.
+	 * Three most significant bits of DSCP are used as UP.
+	 */
+	for (i = 0; i < IP_DSCP_NUM; ++i)
+		map[i] = i >> 3;
+
+	/* Recommended QoS map, defined in section 4 of RFC8325.
+	 * Used in cfg80211_classify8021d since kernel v6.8.
+	 */
+	map[10] = map[12] = map[14] = map[16] = 0;
+	map[18] = map[20] = map[22] = 3;
+	map[24] = map[26] = map[28] = map[30] = 4;
+	map[40] = 5;
+	map[44] = map[46] = 6;
+	map[48] = 7;
+
+	/* User-defined QoS map. As in cfg80211_classify8021d(), the first
+	 * matching exception and the lowest matching UP range win.
+	 */
+	if (usr_qos_map) {
+		for (i = IEEE80211_NUM_UPS - 1; i >= 0; i--) {
+			u8 low = usr_qos_map->up[i].low;
+			u8 high = usr_qos_map->up[i].high;
+
+			if (low < IP_DSCP_NUM && high < IP_DSCP_NUM && low <= high)
+				memset(map + low, i, high - low + 1);
+		}
+
+		for (i = usr_qos_map->num_des - 1; i >= 0; i--) {
+			u8 dscp = usr_qos_map->dscp_exception[i].dscp;
+			u8 up = usr_qos_map->dscp_exception[i].up;
+
+			if (dscp < IP_DSCP_NUM && up < IEEE80211_NUM_UPS)
+				map[dscp] = up;
+		}
+	}
+
+	mvif->qos_map_set = true;
+}
+
+int mt7996_mcu_set_qos_map(struct mt7996_dev *dev, struct mt7996_vif *mvif,
+			   struct mt7996_vif_link *link)
+{
+	struct {
+		u8 _rsv[4];
+
+		__le16 tag;
+		__le16 len;
+
+		struct {
+			u8 bss_idx;
+			u8 qos_map_enable;
+			u8 __rsv[2];
+			s8 qos_map[IP_DSCP_NUM];
+		} data;
+	} __packed req = {
+		.tag = cpu_to_le16(UNI_CMD_SDO_SET_QOS_MAP),
+		.len = cpu_to_le16(sizeof(req) - 4),
+		.data.bss_idx = link->mt76.idx,
+		.data.qos_map_enable = true,
+	};
+
+	memcpy(req.data.qos_map, mvif->qos_map, IP_DSCP_NUM);
+
+	if (!mt7996_has_wa(dev))
+		return mt76_mcu_send_msg(&dev->mt76, MCU_WA_UNI_CMD(SDO),
+					 &req, sizeof(req), false);
+
+	return mt76_mcu_send_msg(&dev->mt76, MCU_WA_EXT_CMD(SET_QOS_MAP),
+				 &req.data, sizeof(req.data), false);
+}
+
 int mt7996_mcu_set_dup_wtbl(struct mt7996_dev *dev)
 {
 #define DUP_WTBL_NUM	80
--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -401,6 +401,12 @@
 	mt7996_init_bitrate_mask(vif, link);
 
 	mt7996_mcu_add_bss_info(phy, vif, link_conf, mlink, msta_link, true);
+	if (vif->type != NL80211_IFTYPE_MONITOR && !mlink->offchannel) {
+		/* also restores the map after a hardware restart */
+		if (!mvif->qos_map_set)
+			mt7996_mcu_fill_qos_map(mvif, NULL);
+		mt7996_mcu_set_qos_map(dev, mvif, link);
+	}
 	/* defer the first STA_REC of BMC entry to BSS_CHANGED_BSSID for STA
 	 * interface, since firmware only records BSSID when the entry is new
 	 */
@@ -3197,6 +3203,33 @@
 	return ret;
 }
 
+static int
+mt7996_set_qos_map(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+		   struct cfg80211_qos_map *qos_map)
+{
+	struct mt7996_vif *mvif = (struct mt7996_vif *)vif->drv_priv;
+	struct mt7996_dev *dev = mt7996_hw_dev(hw);
+	unsigned long valid_links = vif->valid_links ?: BIT(0);
+	unsigned int link_id;
+	int ret = 0;
+
+	mutex_lock(&dev->mt76.mutex);
+	mt7996_mcu_fill_qos_map(mvif, qos_map);
+	for_each_set_bit(link_id, &valid_links, IEEE80211_MLD_MAX_NUM_LINKS) {
+		struct mt7996_vif_link *link = mt7996_vif_link(dev, vif, link_id);
+
+		if (!link)
+			continue;
+
+		ret = mt7996_mcu_set_qos_map(dev, mvif, link);
+		if (ret)
+			break;
+	}
+	mutex_unlock(&dev->mt76.mutex);
+
+	return ret;
+}
+
 const struct ieee80211_ops mt7996_ops = {
 	.add_chanctx = mt76_add_chanctx,
 	.remove_chanctx = mt76_remove_chanctx,
@@ -3220,6 +3253,7 @@
 	.set_key = mt7996_set_key,
 	.ampdu_action = mt7996_ampdu_action,
 	.set_rts_threshold = mt7996_set_rts_threshold,
+	.set_qos_map = mt7996_set_qos_map,
 	.wake_tx_queue = mt76_wake_tx_queue,
 	.hw_scan = mt76_hw_scan,
 	.cancel_hw_scan = mt76_cancel_hw_scan,

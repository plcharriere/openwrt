From: Paul-Louis Charrière <plcharriere@gmail.com>
Date: Thu, 1 Oct 2026 13:18:04 +0900
Subject: [PATCH] wifi: mt76: mt7996: support per-radio RTS threshold, coverage
 class and antennas

mt7996 applies the RTS threshold, the coverage class and the antennas to
all its radios, also when mac80211 passes the index of one radio.

Apply them to the radio given.  The antennas of a radio are counted from
its first one; also fill the antenna mask of each wiphy radio, which
cfg80211 checks them against.

Based-on-patch-by: Michael-CY Lee <michael-cy.lee@mediatek.com>
Link: https://github.com/mediatek/mtk-openwrt-feeds/blob/22213a321b6dafb2a5e01def97363420e6e938fd/autobuild/unified/filogic/mac80211/25.12/files/package/kernel/mt76/patches/0076-mtk-mt76-mt7996-allow-setting-antenna-with-radio_idx.patch
Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Paul-Louis Charrière <plcharriere@gmail.com>
---
--- a/mt7996/init.c
+++ b/mt7996/init.c
@@ -464,6 +464,7 @@ mt7996_init_wiphy_band(struct ieee80211_
 	radio->n_freq_range = 1;
 	radio->iface_combinations = &if_comb;
 	radio->n_iface_combinations = 1;
+	radio->antenna_mask = phy->orig_chainmask;
 	memcpy(dev->radio_addrs[n_radios].addr, phy->mt76->macaddr, ETH_ALEN);
 	hw->wiphy->n_addresses++;
 	hw->wiphy->n_radio++;
--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -1669,6 +1669,9 @@ static int mt7996_set_rts_threshold(stru
 	for (i = 0; i < hw->wiphy->n_radio; i++) {
 		struct mt7996_phy *phy = dev->radio_phy[i];
 
+		if (radio_idx >= 0 && i != radio_idx)
+			continue;
+
 		ret = mt7996_mcu_set_rts_thresh(phy, val);
 		if (ret)
 			break;
@@ -1887,6 +1890,10 @@ mt7996_set_coverage_class(struct ieee802
 
 	mutex_lock(&dev->mt76.mutex);
 	mt7996_for_each_phy(dev, phy) {
+		if (radio_idx >= 0 && radio_idx < hw->wiphy->n_radio &&
+		    phy != dev->radio_phy[radio_idx])
+			continue;
+
 		phy->coverage_class = max_t(s16, coverage_class, 0);
 		mt7996_mac_set_coverage_class(phy);
 	}
@@ -1894,6 +1901,40 @@ mt7996_set_coverage_class(struct ieee802
 }
 
 static int
+mt7996_set_radio_antenna(struct mt7996_dev *dev, int radio_idx, u32 ant)
+{
+	struct mt7996_phy *phy;
+	u32 chainmask;
+	u8 shift;
+
+	if (radio_idx >= dev->mt76.hw->wiphy->n_radio)
+		return -EINVAL;
+
+	phy = dev->radio_phy[radio_idx];
+	shift = dev->chainshift[phy->mt76->band_idx];
+
+	/* the antennas of a radio are counted from its first one */
+	chainmask = (ant << shift) & phy->orig_chainmask;
+	if (!((chainmask >> shift) & phy->orig_antenna_mask))
+		return -EINVAL;
+
+	mutex_lock(&dev->mt76.mutex);
+
+	phy->mt76->chainmask = chainmask;
+	phy->mt76->antenna_mask = (chainmask >> shift) &
+				  phy->orig_antenna_mask;
+
+	mt76_set_stream_caps(phy->mt76, true);
+	mt7996_set_stream_vht_txbf_caps(phy);
+	mt7996_set_stream_he_eht_caps(phy);
+	mt7996_mcu_set_txpower_sku(phy);
+
+	mutex_unlock(&dev->mt76.mutex);
+
+	return 0;
+}
+
+static int
 mt7996_set_antenna(struct ieee80211_hw *hw, int radio_idx,
 		   u32 tx_ant, u32 rx_ant)
 {
@@ -1903,6 +1944,9 @@ mt7996_set_antenna(struct ieee80211_hw *
 	if (tx_ant != rx_ant)
 		return -EINVAL;
 
+	if (radio_idx >= 0)
+		return mt7996_set_radio_antenna(dev, radio_idx, tx_ant);
+
 	for (i = 0; i < hw->wiphy->n_radio; i++) {
 		struct mt7996_phy *phy = dev->radio_phy[i];
 

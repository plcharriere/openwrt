From: Paul-Louis Charrière <plcharriere@gmail.com>
Date: Thu, 1 Oct 2026 00:10:00 +0900
Subject: [PATCH] net: ethernet: mtk_ppe: keep DSCP and ECN of offloaded flows

The NETSYS v3 PPE writes the DSCP field of IB2 over the DSCP and ECN bits
of every packet of a bound flow.  The driver leaves that field at zero,
so offloaded flows lose their DSCP, and with it their Wi-Fi access
category, and their ECN bits, including the congestion marks of the
routers before.

Tell the PPE to keep both, with the keep bits of each entry and their
enable bit in the table configuration.

Based-on-patch-by: Bo-Cun Chen <bc-bocun.chen@mediatek.com>
Link: https://github.com/mediatek/mtk-openwrt-feeds/blob/22213a321b6dafb2a5e01def97363420e6e938fd/25.12/files/target/linux/mediatek/patches-6.12/999-ppe-23-mtk_ppe-add-keep-dscp-toggle.patch
Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Paul-Louis Charrière <plcharriere@gmail.com>
---
 drivers/net/ethernet/mediatek/mtk_ppe.c      | 30 +++++++++++++++++++-
 drivers/net/ethernet/mediatek/mtk_ppe.h      |  3 ++
 drivers/net/ethernet/mediatek/mtk_ppe_regs.h |  1 +
 3 files changed, 33 insertions(+), 1 deletion(-)

--- a/drivers/net/ethernet/mediatek/mtk_ppe.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe.c
@@ -223,6 +223,29 @@ mtk_foe_entry_ib2(struct mtk_eth *eth, s
 	return &entry->ipv4.ib2;
 }
 
+/* The NETSYS v3 PPE writes the DSCP field of IB2 over the DSCP and ECN bits
+ * of the packets of a flow unless its entry says to keep them.
+ */
+static void
+mtk_foe_entry_keep_tos(struct mtk_eth *eth, struct mtk_foe_entry *entry)
+{
+	u32 keep = MTK_FOE_UDF_KEEP_ECN | MTK_FOE_UDF_KEEP_DSCP;
+
+	if (!mtk_is_netsys_v3_or_greater(eth))
+		return;
+
+	switch (mtk_get_ib1_pkt_type(eth, entry->ib1)) {
+	case MTK_PPE_PKT_TYPE_IPV4_HNAPT:
+	case MTK_PPE_PKT_TYPE_IPV4_ROUTE:
+		entry->ipv4.udf_tsid |= keep;
+		break;
+	case MTK_PPE_PKT_TYPE_IPV6_ROUTE_3T:
+	case MTK_PPE_PKT_TYPE_IPV6_ROUTE_5T:
+		entry->ipv6.udf |= keep;
+		break;
+	}
+}
+
 int mtk_foe_entry_prepare(struct mtk_eth *eth, struct mtk_foe_entry *entry,
 			  int type, int l4proto, u8 pse_port, u8 *src_mac,
 			  u8 *dest_mac)
@@ -277,6 +300,8 @@ int mtk_foe_entry_prepare(struct mtk_eth
 		l2 = &entry->ipv4.l2;
 	}
 
+	mtk_foe_entry_keep_tos(eth, entry);
+
 	l2->dest_mac_hi = get_unaligned_be32(dest_mac);
 	l2->dest_mac_lo = get_unaligned_be16(dest_mac + 4);
 	l2->src_mac_hi = get_unaligned_be32(src_mac);
@@ -810,6 +835,7 @@ mtk_foe_entry_commit_subflow(struct mtk_
 		l2->etype = ETH_P_IPV6;
 
 	*mtk_foe_entry_ib2(ppe->eth, &flow_info->data) = entry->data.bridge.ib2;
+	mtk_foe_entry_keep_tos(ppe->eth, &flow_info->data);
 
 	__mtk_foe_entry_commit(ppe, &flow_info->data, hash);
 }
@@ -1074,7 +1100,9 @@ void mtk_ppe_start(struct mtk_ppe *ppe)
 			 MTK_PPE_ENTRIES_SHIFT);
 	if (mtk_is_netsys_v2_or_greater(ppe->eth))
 		val |= MTK_PPE_TB_CFG_INFO_SEL;
-	if (!mtk_is_netsys_v3_or_greater(ppe->eth))
+	if (mtk_is_netsys_v3_or_greater(ppe->eth))
+		val |= MTK_PPE_TB_CFG_KEEP_DSCP_ECN;
+	else
 		val |= MTK_PPE_TB_CFG_ENTRY_80B;
 	ppe_w32(ppe, MTK_PPE_TB_CFG, val);
 
--- a/drivers/net/ethernet/mediatek/mtk_ppe.h
+++ b/drivers/net/ethernet/mediatek/mtk_ppe.h
@@ -98,6 +98,9 @@ enum {
 #define MTK_FOE_WINFO_AMSDU_HF		BIT(23)
 #define MTK_FOE_WINFO_AMSDU_EN		BIT(24)
 
+#define MTK_FOE_UDF_KEEP_ECN		BIT(9)
+#define MTK_FOE_UDF_KEEP_DSCP		BIT(10)
+
 #define MTK_FOE_TPORT_IDX		GENMASK(3, 0)
 
 enum {
--- a/drivers/net/ethernet/mediatek/mtk_ppe_regs.h
+++ b/drivers/net/ethernet/mediatek/mtk_ppe_regs.h
@@ -59,6 +59,7 @@
 #define MTK_PPE_TB_CFG_HASH_DEBUG		GENMASK(19, 18)
 #define MTK_PPE_TB_CFG_INFO_SEL			BIT(20)
 #define MTK_PPE_TB_TICK_SEL			BIT(24)
+#define MTK_PPE_TB_CFG_KEEP_DSCP_ECN		BIT(25)
 
 #define MTK_PPE_BIND_LMT1			0x230
 #define MTK_PPE_NTU_KEEPALIVE			GENMASK(23, 16)

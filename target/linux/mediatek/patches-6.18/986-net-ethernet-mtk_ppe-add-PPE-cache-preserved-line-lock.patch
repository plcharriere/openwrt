From: Bo-Cun Chen <bc-bocun.chen@mediatek.com>
Date: Wed, 24 Sep 2025 12:57:21 +0800
Subject: [PATCH] net: ethernet: mtk_ppe: add PPE cache preserved line lock

Without this patch, the driver would mistakenly enable the preserved
cache line of PPE which should not be used, cause the unexpected
behavior happen in system.

Link: https://github.com/mediatek/mtk-openwrt-feeds/blob/08196fa6e5d338ce88aa0002f781e2d24289b1f1/25.12/files/target/linux/mediatek/patches-6.12/999-ppe-14-mtk_ppe-add-PPE-cache-preserved-line-lock.patch
Signed-off-by: Bo-Cun Chen <bc-bocun.chen@mediatek.com>
[plcharriere: clear the cache once after invalidating the entries of a
station or of a bridge flow, not once per entry; write only the tag of
the preserved line; poll the cache request every microsecond for up to a
millisecond instead of every millisecond for up to a second, and rate
limit the warnings, as the clear runs with bottom halves disabled; when
the cache does not become idle, still invalidate its lines as before, so
that no removed entry stays cached]
Assisted-by: Claude:claude-opus-5-5
Co-developed-by: Paul-Louis Charrière <plcharriere@gmail.com>
Signed-off-by: Paul-Louis Charrière <plcharriere@gmail.com>
---
 drivers/net/ethernet/mediatek/mtk_ppe.c      | 147 ++++++++++++++++++++++++++++++++++++++++++++++----
 drivers/net/ethernet/mediatek/mtk_ppe.h      |   2 ++
 drivers/net/ethernet/mediatek/mtk_ppe_regs.h |  14 ++++++++++++++
 3 files changed, 151 insertions(+), 12 deletions(-)

--- a/drivers/net/ethernet/mediatek/mtk_ppe.c
+++ b/drivers/net/ethernet/mediatek/mtk_ppe.c
@@ -78,6 +78,21 @@ static int mtk_ppe_wait_busy(struct mtk_
 	return ret;
 }
 
+static int mtk_ppe_cache_wait_busy(struct mtk_ppe *ppe)
+{
+	int ret;
+	u32 val;
+
+	ret = readl_poll_timeout_atomic(ppe->base + MTK_PPE_CACHE_CTL, val,
+					!(val & MTK_PPE_CACHE_CTL_REQ),
+					1, 1000);
+
+	if (ret)
+		dev_err_ratelimited(ppe->dev, "PPE cache busy\n");
+
+	return ret;
+}
+
 static int mtk_ppe_mib_wait_busy(struct mtk_ppe *ppe)
 {
 	int ret;
@@ -141,15 +156,110 @@ struct mtk_foe_accounting *mtk_ppe_mib_e
 	return acct;
 }
 
+static void mtk_ppe_cache_write_tag(struct mtk_ppe *ppe, u32 line, u32 tag,
+				    u32 state)
+{
+	/* write the tag field of the cache line */
+	ppe_m32(ppe, MTK_PPE_CACHE_RW, MTK_PPE_CACHE_RW_LINE,
+		FIELD_PREP(MTK_PPE_CACHE_RW_LINE, line));
+	ppe_m32(ppe, MTK_PPE_CACHE_RW, MTK_PPE_CACHE_RW_OFFSET,
+		FIELD_PREP(MTK_PPE_CACHE_RW_OFFSET, 0x1F));
+	ppe_m32(ppe, MTK_PPE_CACHE_CTL, MTK_PPE_CACHE_CTL_DATA_SEL,
+		FIELD_PREP(MTK_PPE_CACHE_CTL_DATA_SEL, 0));
+	ppe_w32(ppe, MTK_PPE_CACHE_WDATA, (state << 16) | tag);
+	/* software access cache command = write */
+	ppe_m32(ppe, MTK_PPE_CACHE_CTL, MTK_PPE_CACHE_CTL_CMD,
+		FIELD_PREP(MTK_PPE_CACHE_CTL_CMD, 3));
+	/* trigger software access cache request */
+	ppe_set(ppe, MTK_PPE_CACHE_CTL, MTK_PPE_CACHE_CTL_REQ);
+	if (mtk_ppe_cache_wait_busy(ppe))
+		dev_warn_ratelimited(ppe->dev,
+				     "%s: write tag 0x%04x timeout in line %u\n",
+				     ppe->dirname, tag, line);
+}
+
 static void mtk_ppe_cache_clear(struct mtk_ppe *ppe)
 {
+	static const u32 mask = MTK_PPE_ALERT_TCP_FIN_RST_SYN |
+				MTK_PPE_MD_TOAP_BYP_CRSN0 |
+				MTK_PPE_MD_TOAP_BYP_CRSN1 |
+				MTK_PPE_MD_TOAP_BYP_CRSN2 |
+				MTK_PPE_FLOW_CFG_IP_PROTO_BLACKLIST |
+				MTK_PPE_FLOW_CFG_IP4_NAT_FRAG |
+				MTK_PPE_FLOW_CFG_IP4_HASH_GRE_KEY |
+				MTK_PPE_FLOW_CFG_IP6_HASH_GRE_KEY |
+				MTK_PPE_FLOW_CFG_CS0_RM_ALL_IP6_IP_EN |
+				MTK_PPE_FLOW_CFG_L2_HASH_ETH |
+				MTK_PPE_FLOW_CFG_L2_HASH_VID;
+	u32 cah_en, flow_cfg, scan_mode;
+	u32 i, idle, retry;
+
+	spin_lock_bh(&ppe->cache_lock);
+
+	/* disable table learning */
+	flow_cfg = ppe_r32(ppe, MTK_PPE_FLOW_CFG);
+	ppe_w32(ppe, MTK_PPE_FLOW_CFG, flow_cfg & mask);
+
+	/* wait PPE return to idle */
+	udelay(100);
+
+	for (retry = 0; retry < 10; retry++) {
+		for (i = 0, idle = 0; i < 3; i++) {
+			if ((ppe_r32(ppe, MTK_PPE_CACHE_DBG) & MTK_PPE_CACHE_DBG_BUSY) == 0)
+				idle++;
+		}
+
+		if (idle >= 3)
+			break;
+
+		udelay(10);
+	}
+
+	if (retry >= 10) {
+		dev_warn_ratelimited(ppe->dev, "%s: cache idle check timeout\n",
+				     ppe->dirname);
+		/* still invalidate the lines, so that no removed entry stays
+		 * cached
+		 */
+		ppe_set(ppe, MTK_PPE_CACHE_CTL, MTK_PPE_CACHE_CTL_CLEAR);
+		ppe_clear(ppe, MTK_PPE_CACHE_CTL, MTK_PPE_CACHE_CTL_CLEAR);
+		goto out;
+	}
+
+	/* disable scan mode */
+	scan_mode = FIELD_GET(MTK_PPE_TB_CFG_SCAN_MODE, ppe_r32(ppe, MTK_PPE_TB_CFG));
+	ppe_clear(ppe, MTK_PPE_TB_CFG, MTK_PPE_TB_CFG_SCAN_MODE);
+	/* disable cache */
+	cah_en = FIELD_GET(MTK_PPE_CACHE_CTL_EN, ppe_r32(ppe, MTK_PPE_CACHE_CTL));
+	ppe_clear(ppe, MTK_PPE_CACHE_CTL, MTK_PPE_CACHE_CTL_EN);
+
+	/* invalidate PPE cache lines */
 	ppe_set(ppe, MTK_PPE_CACHE_CTL, MTK_PPE_CACHE_CTL_CLEAR);
 	ppe_clear(ppe, MTK_PPE_CACHE_CTL, MTK_PPE_CACHE_CTL_CLEAR);
+
+	/* lock the preserved cache line */
+	if (mtk_is_netsys_v2_or_greater(ppe->eth))
+		mtk_ppe_cache_write_tag(ppe, 0, 0x7FFF, 3);
+	else
+		mtk_ppe_cache_write_tag(ppe, 0, 0x3FFF, 3);
+
+	/* restore cache enable */
+	ppe_m32(ppe, MTK_PPE_CACHE_CTL, MTK_PPE_CACHE_CTL_EN,
+		FIELD_PREP(MTK_PPE_CACHE_CTL_EN, cah_en));
+	/* restore scan mode */
+	ppe_m32(ppe, MTK_PPE_TB_CFG, MTK_PPE_TB_CFG_SCAN_MODE,
+		FIELD_PREP(MTK_PPE_TB_CFG_SCAN_MODE, scan_mode));
+out:
+	/* restore table learning */
+	ppe_w32(ppe, MTK_PPE_FLOW_CFG, flow_cfg);
+
+	spin_unlock_bh(&ppe->cache_lock);
 }
 
 static void mtk_ppe_cache_enable(struct mtk_ppe *ppe, bool enable)
 {
-	mtk_ppe_cache_clear(ppe);
+	if (enable)
+		mtk_ppe_cache_clear(ppe);
 
 	ppe_m32(ppe, MTK_PPE_CACHE_CTL, MTK_PPE_CACHE_CTL_EN,
 		enable * MTK_PPE_CACHE_CTL_EN);
@@ -546,37 +656,46 @@ mtk_flow_entry_match(struct mtk_eth *eth
 	return !memcmp(&entry->data.data, &data->data, len - 4);
 }
 
-static void
+/* Returns true if a bound hardware entry was invalidated: the caller then has
+ * to clear the PPE cache.
+ */
+static bool
 __mtk_foe_entry_clear(struct mtk_ppe *ppe, struct mtk_flow_entry *entry,
 		      bool set_state)
 {
 	struct hlist_node *tmp;
+	bool bound = false;
+	int state;
 
 	if (entry->type == MTK_FLOW_TYPE_L2) {
 		rhashtable_remove_fast(&ppe->l2_flows, &entry->l2_node,
 				       mtk_flow_l2_ht_params);
 
 		hlist_for_each_entry_safe(entry, tmp, &entry->l2_flows, l2_list)
-			__mtk_foe_entry_clear(ppe, entry, set_state);
-		return;
+			bound |= __mtk_foe_entry_clear(ppe, entry, set_state);
+		return bound;
 	}
 
 	if (entry->hash != 0xffff && set_state) {
 		struct mtk_foe_entry *hwe = mtk_foe_get_entry(ppe, entry->hash);
 
+		state = FIELD_GET(MTK_FOE_IB1_STATE, hwe->ib1);
+
 		hwe->ib1 &= ~MTK_FOE_IB1_STATE;
 		hwe->ib1 |= FIELD_PREP(MTK_FOE_IB1_STATE, MTK_FOE_STATE_INVALID);
 		dma_wmb();
-		mtk_ppe_cache_clear(ppe);
+		bound = state == MTK_FOE_STATE_BIND;
 	}
 	entry->hash = 0xffff;
 
 	if (entry->type != MTK_FLOW_TYPE_L2_SUBFLOW)
-		return;
+		return bound;
 
 	hlist_del_init(&entry->l2_list);
 	hlist_del_init(&entry->list);
 	kfree(entry);
+
+	return bound;
 }
 
 static int __mtk_foe_entry_idle_time(struct mtk_ppe *ppe, u32 ib1)
@@ -722,14 +841,13 @@ __mtk_foe_entry_commit(struct mtk_ppe *p
 		acct->packets = 0;
 		acct->bytes = 0;
 	}
-
-	mtk_ppe_cache_clear(ppe);
 }
 
 void mtk_foe_entry_clear(struct mtk_ppe *ppe, struct mtk_flow_entry *entry)
 {
 	spin_lock_bh(&ppe_lock);
-	__mtk_foe_entry_clear(ppe, entry, true);
+	if (__mtk_foe_entry_clear(ppe, entry, true))
+		mtk_ppe_cache_clear(ppe);
 	hlist_del_init(&entry->list);
 	spin_unlock_bh(&ppe_lock);
 }
@@ -744,6 +862,7 @@ void mtk_ppe_flush_wcid(struct mtk_ppe *
 	unsigned int i, n = MTK_PPE_ENTRIES / ppe->eth->soc->hash_offset;
 	struct mtk_flow_entry *entry;
 	struct hlist_node *tmp;
+	bool bound = false;
 
 	spin_lock_bh(&ppe_lock);
 	for (i = 0; i < n; i++) {
@@ -753,11 +872,13 @@ void mtk_ppe_flush_wcid(struct mtk_ppe *
 			    (wcid >= 0 && entry->wcid != wcid))
 				continue;
 
-			__mtk_foe_entry_clear(ppe, entry, true);
+			bound |= __mtk_foe_entry_clear(ppe, entry, true);
 			hlist_del_init(&entry->list);
 			WRITE_ONCE(entry->stale, true);
 		}
 	}
+	if (bound)
+		mtk_ppe_cache_clear(ppe);
 	spin_unlock_bh(&ppe_lock);
 }
 
@@ -1001,6 +1122,8 @@ struct mtk_ppe *mtk_ppe_init(struct mtk_
 		ppe->acct_table = acct;
 	}
 
+	spin_lock_init(&ppe->cache_lock);
+
 	mtk_ppe_debugfs_init(ppe, index);
 
 	return ppe;
@@ -1109,8 +1232,6 @@ void mtk_ppe_start(struct mtk_ppe *ppe)
 	ppe_w32(ppe, MTK_PPE_IP_PROTO_CHK,
 		MTK_PPE_IP_PROTO_CHK_IPV4 | MTK_PPE_IP_PROTO_CHK_IPV6);
 
-	mtk_ppe_cache_enable(ppe, true);
-
 	val = MTK_PPE_FLOW_CFG_IP6_3T_ROUTE |
 	      MTK_PPE_FLOW_CFG_IP6_5T_ROUTE |
 	      MTK_PPE_FLOW_CFG_IP6_6RD |
@@ -1162,6 +1283,8 @@ void mtk_ppe_start(struct mtk_ppe *ppe)
 	      MTK_PPE_GLO_CFG_FLOW_DROP_UPDATE;
 	ppe_w32(ppe, MTK_PPE_GLO_CFG, val);
 
+	mtk_ppe_cache_enable(ppe, true);
+
 	ppe_w32(ppe, MTK_PPE_DEFAULT_CPU_PORT, 0);
 
 	if (mtk_is_netsys_v2_or_greater(ppe->eth)) {
--- a/drivers/net/ethernet/mediatek/mtk_ppe.h
+++ b/drivers/net/ethernet/mediatek/mtk_ppe.h
@@ -354,6 +354,8 @@ struct mtk_ppe {
 	struct rhashtable l2_flows;
 
 	void *acct_table;
+
+	spinlock_t cache_lock;
 };
 
 struct mtk_ppe *mtk_ppe_init(struct mtk_eth *eth, void __iomem *base, int index);
--- a/drivers/net/ethernet/mediatek/mtk_ppe_regs.h
+++ b/drivers/net/ethernet/mediatek/mtk_ppe_regs.h
@@ -21,6 +21,7 @@
 #define MTK_PPE_GLO_CFG_BUSY			BIT(31)
 
 #define MTK_PPE_FLOW_CFG			0x204
+#define MTK_PPE_ALERT_TCP_FIN_RST_SYN		BIT(0)
 #define MTK_PPE_MD_TOAP_BYP_CRSN0		BIT(1)
 #define MTK_PPE_MD_TOAP_BYP_CRSN1		BIT(2)
 #define MTK_PPE_MD_TOAP_BYP_CRSN2		BIT(3)
@@ -38,6 +39,9 @@
 #define MTK_PPE_FLOW_CFG_IP4_HASH_FLOW_LABEL	BIT(18)
 #define MTK_PPE_FLOW_CFG_IP4_HASH_GRE_KEY	BIT(19)
 #define MTK_PPE_FLOW_CFG_IP6_HASH_GRE_KEY	BIT(20)
+#define MTK_PPE_FLOW_CFG_CS0_RM_ALL_IP6_IP_EN	BIT(25)
+#define MTK_PPE_FLOW_CFG_L2_HASH_ETH		BIT(29)
+#define MTK_PPE_FLOW_CFG_L2_HASH_VID		BIT(30)
 
 #define MTK_PPE_IP_PROTO_CHK			0x208
 #define MTK_PPE_IP_PROTO_CHK_IPV4		GENMASK(15, 0)
@@ -143,6 +147,13 @@ enum {
 #define MTK_PPE_CACHE_CTL_REQ			BIT(8)
 #define MTK_PPE_CACHE_CTL_CLEAR			BIT(9)
 #define MTK_PPE_CACHE_CTL_CMD			GENMASK(13, 12)
+#define MTK_PPE_CACHE_CTL_DATA_SEL		GENMASK(19, 18)

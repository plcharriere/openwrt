From 718ecef786eff0dd507d678a8a9291ccbcf74aed Mon Sep 17 00:00:00 2001
From: developer <developer@mediatek.com>
Date: Mon, 19 Jan 2026 18:07:48 +0800
Subject: [PATCH] net: phy: mediatek: serialize MT7987 firmware loading

The MT7987 built-in 2.5G PHY firmware loader performs a sequence of Clause
22 and Clause 45 accesses while changing MCU and PHY state.  Other PHYs can
share the MDIO bus, so allowing another transaction to interleave with this
sequence can corrupt firmware loading or PHY setup.

Hold the MDIO bus lock across the complete hardware programming sequence
and use the unlocked PHY helpers while the lock is held.  Route both the
second firmware request failure and its size-validation failure through the
matching unlock path.  This error-path handling is required by the Linux
6.18 implementation and intentionally differs from the vendor patch, which
would leave the bus locked on those failures.

Limit the change to the MT7987 loader; other built-in PHY implementations
retain their existing behavior.

This is adapted from MediaTek's MT7987 firmware-loading serialization
change, with the Linux 6.18 error paths corrected as described above.

Link: https://github.com/mediatek/mtk-openwrt-feeds/commit/718ecef786eff0dd507d678a8a9291ccbcf74aed
Assisted-by: Codex:gpt-5.6-sol
Signed-off-by: Paul-Louis Charrière <plcharriere@gmail.com>
---
 drivers/net/phy/mediatek/mtk-2p5ge.c | 34 +++++++++++++++++++++-------------
 1 file changed, 21 insertions(+), 13 deletions(-)

--- a/drivers/net/phy/mediatek/mtk-2p5ge.c
+++ b/drivers/net/phy/mediatek/mtk-2p5ge.c
@@ -186,10 +186,12 @@ static int mt7987_2p5ge_phy_load_fw(stru
 		goto release_fw;
 	}
 
+	phy_lock_mdio_bus(phydev);
+
 	/* Force 2.5Gphy back to AN state */
-	phy_set_bits(phydev, MII_BMCR, BMCR_RESET);
+	__phy_set_bits(phydev, MII_BMCR, BMCR_RESET);
 	usleep_range(5000, 6000);
-	phy_set_bits(phydev, MII_BMCR, BMCR_PDOWN);
+	__phy_set_bits(phydev, MII_BMCR, BMCR_PDOWN);
 
 	reg = readw(apb_base + SW_RESET);
 	writew(reg & ~MD32_RESTART_EN_CLEAR, apb_base + SW_RESET);
@@ -232,17 +234,17 @@ static int mt7987_2p5ge_phy_load_fw(stru
 		dev_err(dev, "Fail to enable 2.5Gbps module clock: %d\n", ret);
 
 	/* Disable AN */
-	phy_clear_bits(phydev, MII_BMCR, BMCR_ANENABLE);
+	__phy_clear_bits(phydev, MII_BMCR, BMCR_ANENABLE);
 
 	/* Force to run at 2.5G speed */
-	phy_modify_mmd(phydev, MDIO_MMD_VEND1, MTK_PHY_AN_FORCE_SPEED_REG,
-		       MTK_PHY_MASTER_FORCE_SPEED_SEL_MASK,
-		       MTK_PHY_MASTER_FORCE_SPEED_SEL_EN |
-		       FIELD_PREP(MTK_PHY_MASTER_FORCE_SPEED_SEL_MASK, 0x1b));
-
-	phy_set_bits_mmd(phydev, MDIO_MMD_VEND1, MTK_PHY_LINK_STATUS_RELATED,
-			 MTK_PHY_BYPASS_LINK_STATUS_OK |
-			 MTK_PHY_FORCE_LINK_STATUS_HCD);
+	__phy_modify_mmd(phydev, MDIO_MMD_VEND1, MTK_PHY_AN_FORCE_SPEED_REG,
+			 MTK_PHY_MASTER_FORCE_SPEED_SEL_MASK,
+			 MTK_PHY_MASTER_FORCE_SPEED_SEL_EN |
+			 FIELD_PREP(MTK_PHY_MASTER_FORCE_SPEED_SEL_MASK, 0x1b));
+
+	__phy_set_bits_mmd(phydev, MDIO_MMD_VEND1, MTK_PHY_LINK_STATUS_RELATED,
+			   MTK_PHY_BYPASS_LINK_STATUS_OK |
+			   MTK_PHY_FORCE_LINK_STATUS_HCD);
 
 	/* Set xbz, pma and rx as "do not reset" in order to input DSP code. */
 	reg = readl(pmd_reg_base + DO_NOT_RESET);
@@ -289,13 +291,13 @@ static int mt7987_2p5ge_phy_load_fw(stru
 	if (ret) {
 		dev_err(dev, "failed to load firmware: %s, ret: %d\n",
 			MT7987_2P5GE_DSPBITTB, ret);
-		goto free_pmb_addr;
+		goto unlock_mdio;
 	}
 	if (fw->size != MT7987_2P5GE_DSPBITTB_SIZE) {
 		dev_err(dev, "DSPBITTB size 0x%zx != 0x%x\n",
 			fw->size, MT7987_2P5GE_DSPBITTB_SIZE);
 		ret = -EINVAL;
-		goto release_fw;
+		goto release_fw_unlock;
 	}
 
 	for (i = 0; i < fw->size - 1; i += 16) {
@@ -323,11 +325,17 @@ static int mt7987_2p5ge_phy_load_fw(stru
 
 	reg = readw(mcu_csr_base + MD32_EN_CFG);
 	writew(reg | MD32_EN, mcu_csr_base + MD32_EN_CFG);
-	phy_set_bits(phydev, MII_BMCR, BMCR_RESET);
+	__phy_set_bits(phydev, MII_BMCR, BMCR_RESET);
 	/* We need a delay here to stabilize initialization of MCU */
 	usleep_range(7000, 8000);
 	dev_info(dev, "Firmware loading/trigger ok.\n");
 
+release_fw_unlock:
+	release_firmware(fw);
+unlock_mdio:
+	phy_unlock_mdio_bus(phydev);
+	goto free_pmb_addr;
+
 release_fw:
 	release_firmware(fw);
 free_pmb_addr:

From: Paul-Louis Charrière <plcharriere@gmail.com>
Date: Sun, 27 Sep 2026 22:33:00 +0900
Subject: [PATCH] net: ethernet: mtk_eth_soc: add MT7987 misc error IRQ

The MT7987 Frame Engine reports TSO and RX FIFO errors through its fourth
interrupt, but the driver only requests the TX and RX interrupts, so these
errors are only seen when a TX watchdog timeout reads the status register.

Request the fe3 interrupt on MT7987, route the error group to it and
enable the five error sources.  The handler masks an asserted source, so a
persistent fault cannot storm the CPU, logs it and leaves its status
latched: as before, mtk_tx_timeout() decides whether a stalled transmit
path needs a reset.  FQ_EMPTY is not enabled, since normal buffer
pressure raises it.  Warm reset clears the status and enables the sources
again, with the IRQ disabled around it.

The interrupt is optional: if it is missing or cannot be requested, the
driver says so and works as before.  Serialize updates of the shared
interrupt enable register with the Frame Engine register lock.

MediaTek's patch requests this interrupt on NETSYS v3 SoCs with PDMA
interrupts, clears the asserted status and resets the Frame Engine when
forced resets are enabled.

Based-on-patch-by: developer <developer@mediatek.com>
Link: https://github.com/mediatek/mtk-openwrt-feeds/commit/13c73de25ef3f53f5dabdc2f2b410f3aaccbcd0d
Link: https://github.com/mediatek/mtk-openwrt-feeds/commit/a8527f94518357db2a969fe008e8eed9a5fdbf38
Assisted-by: Codex:gpt-5.6-sol
Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Paul-Louis Charrière <plcharriere@gmail.com>
---
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -3844,6 +3844,36 @@ static void mtk_tx_timeout(struct net_de
 	schedule_work(&eth->pending_work);
 }
 
+static bool mtk_has_misc_irq(const struct mtk_eth *eth)
+{
+	return eth->irq_misc > 0;
+}
+
+static int mtk_get_misc_irq(struct platform_device *pdev,
+			    struct mtk_eth *eth)
+{
+	int irq;
+
+	if (!eth->soc->has_misc_irq)
+		return 0;
+
+	irq = platform_get_irq_byname_optional(pdev, "fe3");
+	if (irq == -ENXIO)
+		irq = platform_get_irq_optional(pdev, 3);
+	if (irq == -ENXIO) {
+		dev_warn(&pdev->dev,
+			 "no FE misc IRQ, Frame Engine errors are not reported\n");
+		return 0;
+	}
+	if (irq < 0)
+		return dev_err_probe(&pdev->dev, irq,
+				     "Error requesting FE misc IRQ\n");
+
+	eth->irq_misc = irq;
+
+	return 0;
+}
+
 static int mtk_get_irqs(struct platform_device *pdev, struct mtk_eth *eth)
 {
 	int i;
@@ -3852,7 +3882,7 @@ static int mtk_get_irqs(struct platform_
 	eth->irq[MTK_FE_IRQ_TX] = platform_get_irq_byname_optional(pdev, "fe1");
 	eth->irq[MTK_FE_IRQ_RX] = platform_get_irq_byname_optional(pdev, "fe2");
 	if (eth->irq[MTK_FE_IRQ_TX] >= 0 && eth->irq[MTK_FE_IRQ_RX] >= 0)
-		return 0;
+		return mtk_get_misc_irq(pdev, eth);
 
 	/* only use legacy mode if platform_get_irq_byname_optional returned -ENXIO */
 	if (eth->irq[MTK_FE_IRQ_TX] != -ENXIO)
@@ -3888,7 +3918,7 @@ static int mtk_get_irqs(struct platform_
 		}
 	}
 
-	return 0;
+	return mtk_get_misc_irq(pdev, eth);
 }
 
 static irqreturn_t mtk_handle_irq_rx(int irq, void *_eth)
@@ -3936,6 +3966,41 @@ static irqreturn_t mtk_handle_irq(int ir
 	return IRQ_HANDLED;
 }
 
+static irqreturn_t mtk_handle_irq_misc(int irq, void *_eth)
+{
+	struct mtk_eth *eth = _eth;
+	u32 status;
+
+	status = mtk_r32(eth, MTK_INT_STATUS2);
+	status &= mtk_r32(eth, MTK_FE_INT_ENABLE);
+	status &= MTK_FE_INT_ERROR_MASK;
+	if (!status)
+		return IRQ_NONE;
+
+	/* Keep the status latched for mtk_tx_timeout().  Mask asserted sources
+	 * so a persistent fault cannot storm the CPU before the watchdog has
+	 * decided whether recovery is necessary.
+	 */
+	mtk_fe_m32(eth, status, 0, MTK_FE_INT_ENABLE);
+	dev_err_ratelimited(eth->dev,
+			    "Frame Engine error interrupt: %#x\n", status);
+
+	return IRQ_HANDLED;
+}
+
+static void mtk_misc_irq_enable(struct mtk_eth *eth)
+{
+	mtk_w32(eth, MTK_FE_INT_ERROR_MASK | MTK_FE_INT_FQ_EMPTY,
+		MTK_INT_STATUS2);
+	mtk_fe_m32(eth, MTK_FE_INT_ERROR_MASK, MTK_FE_INT_ERROR_MASK,
+		   MTK_FE_INT_ENABLE);
+}
+
+static void mtk_misc_irq_disable(struct mtk_eth *eth)
+{
+	mtk_fe_m32(eth, MTK_FE_INT_ERROR_MASK, 0, MTK_FE_INT_ENABLE);
+}
+
 #ifdef CONFIG_NET_POLL_CONTROLLER
 static void mtk_poll_controller(struct net_device *dev)
 {
@@ -4814,6 +4879,17 @@ static int mtk_hw_init(struct mtk_eth *e
 	mtk_w32(eth, MTK_TX_DONE_INT, reg_map->qdma.int_grp);
 	mtk_w32(eth, eth->soc->rx.irq_done_mask, reg_map->qdma.int_grp + 4);
 	mtk_w32(eth, 0x21021000, MTK_FE_INT_GRP);
+	if (mtk_has_misc_irq(eth)) {
+		mtk_m32(eth, MTK_FE_INT_GRP_MISC,
+			FIELD_PREP(MTK_FE_INT_GRP_MISC,
+				   MTK_FE_INT_GRP_MISC_ID),
+			MTK_FE_INT_GRP);
+
+		if (reset)
+			mtk_misc_irq_enable(eth);
+		else
+			mtk_misc_irq_disable(eth);
+	}
 
 	if (mtk_is_netsys_v3_or_greater(eth)) {
 		/* PSE dummy page mechanism */
@@ -4916,6 +4992,9 @@ static int mtk_hw_deinit(struct mtk_eth
 	if (!test_and_clear_bit(MTK_HW_INIT, &eth->state))
 		return 0;
 
+	if (mtk_has_misc_irq(eth))
+		mtk_misc_irq_disable(eth);
+
 	mtk_clk_disable(eth);
 
 	pm_runtime_put_sync(eth->dev);
@@ -4995,7 +5074,7 @@ static void mtk_prepare_for_reset(struct
 		mtk_ppe_prepare_reset(eth->ppe[i]);
 
 	/* disable NETSYS interrupts */
-	mtk_w32(eth, 0, MTK_FE_INT_ENABLE);
+	mtk_fe_m32(eth, ~0, 0, MTK_FE_INT_ENABLE);
 
 	/* force link down GMAC */
 	for (i = 0; i < 2; i++) {
@@ -5014,6 +5093,9 @@ static void mtk_pending_work(struct work
 	rtnl_lock();
 	set_bit(MTK_RESETTING, &eth->state);
 
+	if (mtk_has_misc_irq(eth))
+		disable_irq(eth->irq_misc);
+
 	mtk_hw_dump(eth);
 
 	mtk_prepare_for_reset(eth);
@@ -5068,6 +5150,9 @@ static void mtk_pending_work(struct work
 
 	clear_bit(MTK_RESETTING, &eth->state);
 
+	if (mtk_has_misc_irq(eth))
+		enable_irq(eth->irq_misc);
+
 	mtk_wed_fe_reset_complete();
 
 	rtnl_unlock();
@@ -6081,6 +6166,14 @@ static int mtk_probe(struct platform_dev
 	if (err)
 		goto err_free_dev;
 
+	if (mtk_has_misc_irq(eth) &&
+	    devm_request_irq(eth->dev, eth->irq_misc, mtk_handle_irq_misc, 0,
+			     dev_name(eth->dev), eth)) {
+		dev_warn(eth->dev,
+			 "cannot request FE misc IRQ, Frame Engine errors are not reported\n");
+		eth->irq_misc = 0;
+	}
+
 	/* No MT7628/88 support yet */
 	if (!MTK_HAS_CAPS(eth->soc->caps, MTK_SOC_MT7628)) {
 		err = mtk_mdio_init(eth);
@@ -6138,6 +6231,8 @@ static int mtk_probe(struct platform_dev
 	}
 
 	platform_set_drvdata(pdev, eth);
+	if (mtk_has_misc_irq(eth))
+		mtk_misc_irq_enable(eth);
 	schedule_delayed_work(&eth->reset.monitor_work,
 			      MTK_DMA_MONITOR_TIMEOUT);
 
@@ -6169,6 +6264,11 @@ static void mtk_remove(struct platform_d
 {
 	struct mtk_eth *eth = platform_get_drvdata(pdev);
 
+	if (mtk_has_misc_irq(eth)) {
+		disable_irq(eth->irq_misc);
+		mtk_misc_irq_disable(eth);
+	}
+
 	/* Unregistering the netdevs stops DMA while the hardware and PCS are
 	 * still available.
 	 */
@@ -6407,6 +6507,7 @@ static const struct mtk_soc_data mt7987_
 	.hash_offset = 4,
 	.has_accounting = true,
 	.num_tx_queues = 32,
+	.has_misc_irq = true,
 	.foe_entry_size = MTK_FOE_ENTRY_V3_SIZE,
 	.tx = {
 		DESC_SIZE(struct mtk_tx_dma_v2),
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.h
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.h
@@ -104,6 +104,11 @@
 #define MTK_FE_INT_TSO_ALIGN	BIT(14)
 #define MTK_FE_INT_RFIFO_OV	BIT(18)
 #define MTK_FE_INT_RFIFO_UF	BIT(19)
+#define MTK_FE_INT_ERROR_MASK	(MTK_FE_INT_TSO_FAIL | \
+				 MTK_FE_INT_TSO_ILLEGAL | \
+				 MTK_FE_INT_TSO_ALIGN | \
+				 MTK_FE_INT_RFIFO_OV | \
+				 MTK_FE_INT_RFIFO_UF)
 #define MTK_GDM1_AF		BIT(28)
 #define MTK_GDM2_AF		BIT(29)
 
@@ -112,6 +117,8 @@
 
 /* Frame Engine Interrupt Grouping Register */
 #define MTK_FE_INT_GRP		0x20
+#define MTK_FE_INT_GRP_MISC	GENMASK(3, 0)
+#define MTK_FE_INT_GRP_MISC_ID	3
 
 /* CDMP Ingress Control Register */
 #define MTK_CDMQ_IG_CTRL	0x1400
@@ -1298,6 +1305,8 @@ struct mtk_reg_map {
  * @foe_entry_size		Foe table entry size.
  * @has_accounting		Bool indicating support for accounting of
  *				offloaded flows.
+ * @has_misc_irq		Bool indicating support for the Frame Engine
+ *				miscellaneous error interrupt.
  * @desc_shift			Tx/Rx DMA descriptor size (in power-of-2).
  * @irq_done_mask		Rx irq done register mask.
  * @dma_l4_valid		Rx DMA valid register mask.
@@ -1318,6 +1327,7 @@ struct mtk_soc_data {
 	u16		foe_entry_size;
 	netdev_features_t hw_features;
 	bool		has_accounting;
+	bool		has_misc_irq;
 	bool		disable_pll_modes;
 	struct {
 		u32	desc_shift;
@@ -1402,6 +1412,7 @@ struct mtk_eth {
 	struct net_device		*netdev[MTK_MAX_DEVS];
 	struct mtk_mac			*mac[MTK_MAX_DEVS];
 	int				irq[MTK_FE_IRQ_NUM];
+	int				irq_misc;
 	u32				msg_enable;
 	unsigned long			sysclk;
 	struct regmap			*ethsys;

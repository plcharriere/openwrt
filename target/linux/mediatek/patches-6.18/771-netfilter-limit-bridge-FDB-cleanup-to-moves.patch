diff --git a/net/bridge/br_fdb.c b/net/bridge/br_fdb.c
index 6eb3ab69a5140f719ec62ed388ee43fdfac0e79c..466736860c875c596ef1260bafc4ac9861eaad21 100644
--- a/net/bridge/br_fdb.c

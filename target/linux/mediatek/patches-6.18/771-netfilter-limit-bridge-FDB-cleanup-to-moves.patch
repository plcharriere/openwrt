@@ -260,6 +260,48 @@ struct net_device *br_fdb_find_port(const struct net_device *br_dev,
 }
 EXPORT_SYMBOL_GPL(br_fdb_find_port);
 
+/* Return the bridge port used by every non-local entry for @addr.  Returning
+ * an ifindex instead of a device pointer makes this helper safe without RTNL;
+ * zero means that the address is absent or resolves to more than one port.
+ */
+int br_fdb_find_port_ifindex(const struct net_device *br_dev,
+			     const unsigned char *addr)
+{
+	const struct net_bridge_port *dst;
+	struct net_bridge_fdb_entry *f;
+	struct net_bridge *br;
+	int ifindex = 0;
+
+	if (!netif_is_bridge_master(br_dev))
+		return 0;
+
+	br = netdev_priv(br_dev);
+	rcu_read_lock();
+	hlist_for_each_entry_rcu(f, &br->fdb_list, fdb_node) {
+		if (!ether_addr_equal(f->key.addr.addr, addr) ||
+		    test_bit(BR_FDB_LOCAL, &f->flags))
+			continue;
+
+		dst = READ_ONCE(f->dst);
+		if (!dst)
+			continue;
+
+		if (!ifindex) {
+			ifindex = dst->dev->ifindex;
+			continue;
+		}
+
+		if (ifindex != dst->dev->ifindex) {
+			ifindex = 0;
+			break;
+		}
+	}
+	rcu_read_unlock();
+
+	return ifindex;
+}
+EXPORT_SYMBOL_GPL(br_fdb_find_port_ifindex);
+
 struct net_bridge_fdb_entry *br_fdb_find_rcu(struct net_bridge *br,
 					     const unsigned char *addr,
 					     __u16 vid)

 		} else {
 			flow_offload_del(flow_table, flow);
@@ -757,6 +770,224 @@ void nf_flow_table_cleanup(struct net_de
 }
 EXPORT_SYMBOL_GPL(nf_flow_table_cleanup);
 
+#if IS_ENABLED(CONFIG_NET_SWITCHDEV)
+/* Let the FDB updates of one (re)association arrive before rescanning. */
+#define NF_FLOW_FDB_SCAN_DELAY		(HZ / 50)
+/* Addresses kept for one scan. Past that, all tuples are rechecked, at most
+ * once per NF_FLOW_FDB_FULL_SCAN_INTERVAL.
+ */
+#define NF_FLOW_FDB_BATCH		16
+#define NF_FLOW_FDB_FULL_SCAN_INTERVAL	HZ
+
+struct nf_flow_fdb_batch {
+	unsigned int	count;
+	bool		all;
+	u8		addr[NF_FLOW_FDB_BATCH][ETH_ALEN];
+};
+
+struct nf_flow_fdb_scan {
+	struct nf_flow_fdb_batch	batch;
+	bool				found;
+};
+
+static void nf_flow_table_fdb_scan(struct work_struct *work);
+static DECLARE_DELAYED_WORK(nf_flow_fdb_scan_work, nf_flow_table_fdb_scan);
+
+/* Addresses learned since the last scan. */
+static DEFINE_SPINLOCK(nf_flow_fdb_lock);
+static struct nf_flow_fdb_batch nf_flow_fdb_pending;
+static unsigned long nf_flow_fdb_last_full;
+
+static bool nf_flow_fdb_batch_has(const struct nf_flow_fdb_batch *batch,
+				  const u8 *addr)
+{
+	unsigned int i;
+
+	if (batch->all)
+		return true;
+
+	for (i = 0; i < batch->count; i++)
+		if (ether_addr_equal_unaligned(batch->addr[i], addr))
+			return true;
+
+	return false;
+}
+
+static void nf_flow_fdb_batch_add(const u8 *addr)
+{
+	struct nf_flow_fdb_batch *batch = &nf_flow_fdb_pending;
+	unsigned long flags;
+
+	spin_lock_irqsave(&nf_flow_fdb_lock, flags);
+	if (!nf_flow_fdb_batch_has(batch, addr)) {
+		if (batch->count < NF_FLOW_FDB_BATCH)
+			memcpy(batch->addr[batch->count++], addr, ETH_ALEN);
+		else
+			batch->all = true;
+	}
+	spin_unlock_irqrestore(&nf_flow_fdb_lock, flags);
+}
+
+/* Take the addresses to rescan, or return false to postpone a full scan. */
+static bool nf_flow_fdb_batch_take(struct nf_flow_fdb_batch *batch)
+{
+	unsigned long now = jiffies, next;
+
+	spin_lock_irq(&nf_flow_fdb_lock);
+	next = nf_flow_fdb_last_full + NF_FLOW_FDB_FULL_SCAN_INTERVAL;
+	if (nf_flow_fdb_pending.all &&
+	    time_in_range(now, nf_flow_fdb_last_full, next)) {
+		spin_unlock_irq(&nf_flow_fdb_lock);
+		queue_delayed_work(system_power_efficient_wq,
+				   &nf_flow_fdb_scan_work, next - now);
+		return false;
+	}
+
+	*batch = nf_flow_fdb_pending;
+	nf_flow_fdb_pending.count = 0;
+	nf_flow_fdb_pending.all = false;
+	if (batch->all)
+		nf_flow_fdb_last_full = now;
+	spin_unlock_irq(&nf_flow_fdb_lock);
+
+	return true;
+}
+
+static bool nf_flow_tuple_bridge_moved(struct net *net,
+				       const struct flow_offload_tuple *tuple,
+				       const struct nf_flow_fdb_batch *batch)
+{
+	const struct net_device *dev;
+	int port, rec;
+
+	/* Pairs with the release in flow_offload_bridge_check(). */
+	rec = smp_load_acquire(&tuple->br_port_ifidx);
+	if (!rec || !nf_flow_fdb_batch_has(batch, tuple->br_h_dest))
+		return false;
+
+	dev = dev_get_by_index_rcu(net, tuple->br_dev_ifidx);
+	if (!dev)
+		return false;
+
+	/* An address missing from the FDB, e.g. aged out while its traffic
+	 * bypasses the bridge, gives no evidence of a move.
+	 */
+	port = nf_flow_bridge_port(dev, tuple->br_h_dest, NULL);
+
+	return port && port != rec;
+}
+
+static void nf_flow_table_do_fdb_scan(struct nf_flowtable *flowtable,
+				      struct flow_offload *flow, void *data)
+{
+	bool hw = nf_flowtable_hw_offload(flowtable);
+	struct net *net = nf_ct_net(flow->ct);
+	struct nf_flow_fdb_scan *scan = data;
+	int dir;
+
+	if (test_bit(NF_FLOW_TEARDOWN, &flow->flags))
+		return;
+
+	for (dir = 0; dir < FLOW_OFFLOAD_DIR_MAX; dir++) {
+		const struct flow_offload_tuple *tuple =
+			&flow->tuplehash[dir].tuple;
+
+		/* Software neighbour output is switched by the bridge. */
+		if (!hw && tuple->xmit_type != FLOW_OFFLOAD_XMIT_DIRECT)
+			continue;
+
+		if (nf_flow_tuple_bridge_moved(net, tuple, &scan->batch)) {
+			flow_offload_teardown(flow);
+			scan->found = true;
+			return;
+		}
+	}
+}
+
+static void nf_flow_table_fdb_scan(struct work_struct *work)
+{
+	struct nf_flowtable *flowtable;
+	struct nf_flow_fdb_scan scan;
+	bool drain = false;
+
+	if (!nf_flow_fdb_batch_take(&scan.batch))
+		return;
+
+	mutex_lock(&flowtable_lock);
+	list_for_each_entry(flowtable, &flowtables, list) {
+		scan.found = false;
+		nf_flow_table_iterate(flowtable, nf_flow_table_do_fdb_scan,
+				      &scan);
+		if (scan.found && nf_flowtable_hw_offload(flowtable))
+			drain = true;
+	}
+
+	/* Wait for packets that found a flow before its teardown, so that the
+	 * gc run below can queue the hardware delete, then wait for it rather
+	 * than for the next periodic run.
+	 */
+	if (drain) {
+		synchronize_net();
+		list_for_each_entry(flowtable, &flowtables, list) {
+			if (!nf_flowtable_hw_offload(flowtable))
+				continue;
+
+			flush_delayed_work(&flowtable->gc_work);
+			nf_flow_table_offload_flush(flowtable);
+		}
+	}
+	mutex_unlock(&flowtable_lock);
+}
+
+/* A move is reported as a deletion on the old port followed by an addition
+ * on the new one. Deletions alone also come from ageing and flushes, so
+ * rescan on additions and compare the port of the flows to that address
+ * with the current one.
+ */
+static int nf_flow_table_switchdev_event(struct notifier_block *nb,
+					 unsigned long event, void *ptr)
+{
+	struct switchdev_notifier_fdb_info *fdb_info = ptr;
+
+	if (event != SWITCHDEV_FDB_ADD_TO_DEVICE)
+		return NOTIFY_DONE;
+
+	if (fdb_info->is_local || is_multicast_ether_addr(fdb_info->addr) ||
+	    netif_is_bridge_master(switchdev_notifier_info_to_dev(ptr)))
+		return NOTIFY_DONE;
+
+	nf_flow_fdb_batch_add(fdb_info->addr);
+	queue_delayed_work(system_power_efficient_wq, &nf_flow_fdb_scan_work,
+			   NF_FLOW_FDB_SCAN_DELAY);
+
+	return NOTIFY_DONE;
+}
+
+static struct notifier_block nf_flow_table_switchdev_notifier = {
+	.notifier_call	= nf_flow_table_switchdev_event,
+};
+
+static int nf_flow_table_fdb_init(void)
+{
+	return register_switchdev_notifier(&nf_flow_table_switchdev_notifier);
+}
+
+static void nf_flow_table_fdb_exit(void)
+{
+	unregister_switchdev_notifier(&nf_flow_table_switchdev_notifier);
+	cancel_delayed_work_sync(&nf_flow_fdb_scan_work);
+}
+#else
+static int nf_flow_table_fdb_init(void)
+{
+	return 0;
+}
+
+static void nf_flow_table_fdb_exit(void)
+{
+}
+#endif
+
 void nf_flow_table_free(struct nf_flowtable *flow_table)
 {
 	mutex_lock(&flowtable_lock);
@@ -855,8 +1086,14 @@ static int __init nf_flow_table_module_i
 	if (ret)
 		goto out_bpf;
 
+	ret = nf_flow_table_fdb_init();
+	if (ret)
+		goto out_fdb;
+
 	return 0;
 
+out_fdb:
+	unregister_netdevice_notifier(&flow_offload_netdev_notifier);
 out_bpf:
 	nf_flow_table_offload_exit();
 out_offload:
@@ -866,6 +1103,7 @@ out_offload:
 
 static void __exit nf_flow_table_module_exit(void)
 {
+	nf_flow_table_fdb_exit();
 	unregister_netdevice_notifier(&flow_offload_netdev_notifier);
 	rcu_barrier();
 	nf_flow_table_offload_exit();
--- a/net/netfilter/nf_flow_table_path.c
+++ b/net/netfilter/nf_flow_table_path.c
@@ -172,6 +172,72 @@ static void nft_dev_path_info(const stru
 		info->xmit_type = FLOW_OFFLOAD_XMIT_DIRECT;
 }
 
+/* Record the bridge port that forwards the destination of @stack, so that
+ * the flowtable can tell when the bridge learns the address on another port.
+ */
+void nf_flow_route_bridge_port(struct nf_flow_route *route,
+			       enum ip_conntrack_dir dir,
+			       const struct net_device_path_stack *stack,
+			       const u8 *ha)
+{
+	const u8 *daddr = ha;
+	int i;
+
+	for (i = 0; i < stack->num_paths - 1; i++) {
+		const struct net_device_path *path = &stack->path[i];
+
+		if (path->type == DEV_PATH_PPPOE)
+			daddr = path->encap.h_dest;
+		if (path->type != DEV_PATH_BRIDGE)
+			continue;
+
+		route->tuple[dir].br.port_ifindex = stack->path[i + 1].dev->ifindex;
+		memcpy(route->tuple[dir].br.h_dest, daddr, ETH_ALEN);
+		break;
+	}
+}
+EXPORT_SYMBOL_GPL(nf_flow_route_bridge_port);
+
+/* Follow the forward path from @dev towards @addr down to a bridge. Return
+ * the ifindex of the bridge port that forwards the address now, or 0 if there
+ * is none, and store the address the bridge looked up in @br_addr if given.
+ * Called under RCU.
+ */
+int nf_flow_bridge_port(const struct net_device *dev, const u8 *addr,
+			u8 *br_addr)
+{
+	struct net_device_path_ctx ctx = {
+		.dev	= dev,
+	};
+	struct net_device_path path;
+	int i;
+
+	memcpy(ctx.daddr, addr, sizeof(ctx.daddr));
+	for (i = 0; i < NET_DEVICE_PATH_STACK_MAX; i++) {
+		const struct net_device *cur = ctx.dev;
+
+		if (!cur || !cur->netdev_ops->ndo_fill_forward_path)
+			return 0;
+
+		memset(&path, 0, sizeof(path));
+		if (cur->netdev_ops->ndo_fill_forward_path(&ctx, &path) < 0)
+			return 0;
+
+		if (path.type == DEV_PATH_BRIDGE) {
+			if (!ctx.dev)
+				return 0;
+			if (br_addr)
+				memcpy(br_addr, ctx.daddr, ETH_ALEN);
+			return ctx.dev->ifindex;
+		}
+
+		if (ctx.dev == cur)
+			return 0;
+	}
+
+	return 0;
+}
+
 static bool nft_flowtable_find_dev(const struct net_device *dev,
 				   struct nft_flowtable *ft)
 {
@@ -200,8 +266,10 @@ static void nft_dev_forward_path(struct
 	unsigned char ha[ETH_ALEN];
 	int i;
 
-	if (nft_dev_fill_forward_path(route, dst, ct, dir, ha, &stack) >= 0)
+	if (nft_dev_fill_forward_path(route, dst, ct, dir, ha, &stack) >= 0) {
 		nft_dev_path_info(&stack, &info, ha, &ft->data);
+		nf_flow_route_bridge_port(route, dir, &stack, ha);
+	}
 
 	if (info.outdev)
 		route->tuple[dir].out.ifindex = info.outdev->ifindex;
--- a/net/netfilter/nf_flow_table_offload.c
+++ b/net/netfilter/nf_flow_table_offload.c
@@ -4,6 +4,7 @@
 #include <linux/netfilter.h>
 #include <linux/rhashtable.h>
 #include <linux/netdevice.h>
+#include <linux/etherdevice.h>
 #include <linux/tc_act/tc_csum.h>
 #include <net/flow_offload.h>
 #include <net/netfilter/nf_flow_table.h>
@@ -968,11 +969,78 @@ static int flow_offload_rule_add(struct
 	return 0;
 }
 
+/* The driver resolves the port behind a bridge of a neighbour tuple when it
+ * installs the rule. Record that port if the bridge did not know the
+ * destination when the flow was created, and refuse the rule if the bridge
+ * has moved the destination since the port was recorded.
+ */
+static bool flow_offload_bridge_check(struct flow_offload *flow,
+				      enum flow_offload_tuple_dir dir)
+{
+	struct flow_offload_tuple *tuple = &flow->tuplehash[dir].tuple;
+	const struct flow_offload_tuple *other = &flow->tuplehash[!dir].tuple;
+	unsigned char ha[ETH_ALEN], addr[ETH_ALEN];
+	const struct net_device *dev;
+	int ifindex, port, rec;
+	struct neighbour *n;
+	u8 nud_state;
+
+	if (tuple->xmit_type != FLOW_OFFLOAD_XMIT_NEIGH)
+		return true;
+
+	n = dst_neigh_lookup(tuple->dst_cache, &other->src_v4);
+	if (!n)
+		return true;
+
+	read_lock_bh(&n->lock);
+	nud_state = n->nud_state;
+	ether_addr_copy(ha, n->ha);
+	read_unlock_bh(&n->lock);
+	neigh_release(n);
+
+	if (!(nud_state & NUD_VALID))
+		return true;
+
+	rcu_read_lock();
+	dev = dst_dev_rcu(tuple->dst_cache);
+	ifindex = dev->ifindex;
+	port = nf_flow_bridge_port(dev, ha, addr);
+	rcu_read_unlock();
+	if (!port)
+		return true;
+
+	/* The offload work of a flow is serialized by NF_FLOW_HW_PENDING, and
+	 * nothing else writes these fields once the flow is created.
+	 */
+	rec = smp_load_acquire(&tuple->br_port_ifidx);
+	if (!rec) {
+		tuple->br_dev_ifidx = ifindex;
+		memcpy(tuple->br_h_dest, addr, ETH_ALEN);
+		smp_store_release(&tuple->br_port_ifidx, port);
+		return true;
+	}
+
+	return port == rec && ether_addr_equal_unaligned(addr, tuple->br_h_dest);
+}
+
 static void flow_offload_work_add(struct flow_offload_work *offload)
 {
 	struct nf_flow_rule *flow_rule[FLOW_OFFLOAD_DIR_MAX];
+	struct flow_offload *flow = offload->flow;
 	int err;
 
+	/* A flow torn down after this work was queued may already be gone
+	 * from hardware, and nothing would remove the rule again.
+	 */
+	if (test_bit(NF_FLOW_TEARDOWN, &flow->flags))
+		return;
+
+	if (!flow_offload_bridge_check(flow, FLOW_OFFLOAD_DIR_ORIGINAL) ||
+	    !flow_offload_bridge_check(flow, FLOW_OFFLOAD_DIR_REPLY)) {
+		flow_offload_teardown(flow);
+		return;
+	}
+
 	err = nf_flow_offload_alloc(offload, flow_rule);
 	if (err < 0)
 		return;
--- a/net/netfilter/xt_FLOWOFFLOAD.c
+++ b/net/netfilter/xt_FLOWOFFLOAD.c
@@ -397,8 +397,10 @@ static void nf_dev_forward_path(struct n
 	unsigned char ha[ETH_ALEN];
 	int i;
 
-	if (nf_dev_fill_forward_path(route, dst, ct, dir, ha, &stack) >= 0)
+	if (nf_dev_fill_forward_path(route, dst, ct, dir, ha, &stack) >= 0) {
 		nf_dev_path_info(&stack, &info, ha);
+		nf_flow_route_bridge_port(route, dir, &stack, ha);
+	}
 
 	/* The xmit path looks the output device up by index for every xmit
 	 * type, so it has to be set even when the forward path is unknown.

 			u32		iifidx;
 		} tc;
 	};
+
+	/* Bridge port that br_h_dest was forwarded to from br_dev_ifidx
+	 * when the flow was created or first offloaded, or zero if not
+	 * behind a bridge. br_port_ifidx is written last.
+	 */
+	u32				br_dev_ifidx;
+	u32				br_port_ifidx;
+	u8				br_h_dest[ETH_ALEN];
 };
 

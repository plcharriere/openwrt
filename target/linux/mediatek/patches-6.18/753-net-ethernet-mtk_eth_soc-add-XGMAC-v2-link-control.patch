From 8a27a1208f6799696dfc52312d31e24cb90513ef Mon Sep 17 00:00:00 2001
From: Bo-Cun Chen <bc-bocun.chen@mediatek.com>
Date: Thu, 6 Nov 2025 22:15:31 +0800
Subject: [PATCH] net: ethernet: mtk_eth_soc: add XGMAC-v2 link control

MT7987 uses the per-XMAC status force register for forced link state and
TX/RX flow control.  The MT7987 support patch added the XGMAC-v2 register
definitions and capability bit, but the link handling still programs the
legacy XGMAC status and MAC control registers.

Select force mode and force link down through MTK_XMAC_STS_FRC while the
MAC is prepared.  Use the same register to control link state and the
negotiated pause directions during link changes.  Keep the existing path
unchanged for SoCs using the original XGMAC register layout.

This is adapted from MediaTek's Linux 6.12 MT7987 XGMAC-v2 change.  The
current driver initializes XGMAC force mode in mtk_mac_prepare() rather
than mtk_hw_init().

Link: https://github.com/mediatek/mtk-openwrt-feeds/blob/671c2416d6219beb19abbb05709e418a6363be62/25.12/files/target/linux/mediatek/patches-6.12/999-eth-03-mtk_eth_soc-revise-xgmac-force-mode.patch
Assisted-by: Codex:gpt-5.6-sol
Signed-off-by: Paul-Louis Charrière <plcharriere@gmail.com>
---
 drivers/net/ethernet/mediatek/mtk_eth_soc.c | 64 ++++++++++++++++---------
 1 file changed, 44 insertions(+), 20 deletions(-)

--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -564,9 +564,17 @@ static int mtk_mac_prepare(struct phylin
 		mtk_m32(mac->hw, XMAC_MCR_TRX_DISABLE,
 			XMAC_MCR_TRX_DISABLE, MTK_XMAC_MCR(mac->id));
 
-		mtk_m32(mac->hw, MTK_XGMAC_FORCE_MODE(mac->id) |
-				 MTK_XGMAC_FORCE_LINK(mac->id),
-			MTK_XGMAC_FORCE_MODE(mac->id), MTK_XGMAC_STS(mac->id));
+		if (MTK_HAS_CAPS(eth->soc->caps, MTK_XGMAC_V2))
+			mtk_m32(mac->hw, XMAC_FORCE_RX_FC_MODE |
+				 XMAC_FORCE_TX_FC_MODE | XMAC_FORCE_LINK_MODE |
+				 XMAC_FORCE_LINK,
+				 XMAC_FORCE_RX_FC_MODE | XMAC_FORCE_TX_FC_MODE |
+				 XMAC_FORCE_LINK_MODE, MTK_XMAC_STS_FRC(mac->id));
+		else
+			mtk_m32(mac->hw, MTK_XGMAC_FORCE_MODE(mac->id) |
+					 MTK_XGMAC_FORCE_LINK(mac->id),
+				MTK_XGMAC_FORCE_MODE(mac->id),
+				MTK_XGMAC_STS(mac->id));
 	}
 
 	return 0;
@@ -766,6 +774,7 @@ static void mtk_mac_link_down(struct phy
 {
 	struct mtk_mac *mac = container_of(config, struct mtk_mac,
 					   phylink_config);
+	struct mtk_eth *eth = mac->hw;
 
 	if (!mtk_interface_mode_is_xgmii(mac->hw, interface)) {
 		/* GMAC modes */
@@ -779,8 +788,12 @@ static void mtk_mac_link_down(struct phy
 		/* XGMAC except for built-in switch */
 		mtk_m32(mac->hw, XMAC_MCR_TRX_DISABLE, XMAC_MCR_TRX_DISABLE,
 			MTK_XMAC_MCR(mac->id));
-		mtk_m32(mac->hw, MTK_XGMAC_FORCE_LINK(mac->id), 0,
-			MTK_XGMAC_STS(mac->id));
+		if (MTK_HAS_CAPS(eth->soc->caps, MTK_XGMAC_V2))
+			mtk_m32(mac->hw, XMAC_FORCE_LINK, 0,
+				MTK_XMAC_STS_FRC(mac->id));
+		else
+			mtk_m32(mac->hw, MTK_XGMAC_FORCE_LINK(mac->id), 0,
+				MTK_XGMAC_STS(mac->id));
 	}
 }
 
@@ -929,7 +942,8 @@ static void mtk_xgdm_mac_link_up(struct
 				 int speed, int duplex, bool tx_pause,
 				 bool rx_pause)
 {
-	u32 mcr;
+	struct mtk_eth *eth = mac->hw;
+	u32 force, mcr;
 
 	if (mac->id == MTK_GMAC1_ID)
 		return;
@@ -940,21 +954,31 @@ static void mtk_xgdm_mac_link_up(struct
 	mtk_m32(mac->hw, XMAC_GLB_CNTCLR, XMAC_GLB_CNTCLR,
 		MTK_XMAC_CNT_CTRL(mac->id));
 
-	mtk_m32(mac->hw, MTK_XGMAC_FORCE_LINK(mac->id),
-		MTK_XGMAC_FORCE_LINK(mac->id), MTK_XGMAC_STS(mac->id));
+	if (MTK_HAS_CAPS(eth->soc->caps, MTK_XGMAC_V2)) {
+		force = XMAC_FORCE_LINK;
+		if (tx_pause)
+			force |= XMAC_FORCE_TX_FC;
+		if (rx_pause)
+			force |= XMAC_FORCE_RX_FC;
+
+		mtk_m32(mac->hw, XMAC_FORCE_TX_FC | XMAC_FORCE_RX_FC |
+			 XMAC_FORCE_LINK, force, MTK_XMAC_STS_FRC(mac->id));
+		mtk_m32(mac->hw, XMAC_MCR_TRX_DISABLE, 0,
+			MTK_XMAC_MCR(mac->id));
+	} else {
+		mtk_m32(mac->hw, MTK_XGMAC_FORCE_LINK(mac->id),
+			MTK_XGMAC_FORCE_LINK(mac->id), MTK_XGMAC_STS(mac->id));
 
-	mcr = mtk_r32(mac->hw, MTK_XMAC_MCR(mac->id));
-	mcr &= ~(XMAC_MCR_FORCE_TX_FC | XMAC_MCR_FORCE_RX_FC |
-		 XMAC_MCR_TRX_DISABLE);
-	/* Configure pause modes -
-	 * phylink will avoid these for half duplex
-	 */
-	if (tx_pause)
-		mcr |= XMAC_MCR_FORCE_TX_FC;
-	if (rx_pause)
-		mcr |= XMAC_MCR_FORCE_RX_FC;
+		mcr = mtk_r32(mac->hw, MTK_XMAC_MCR(mac->id));
+		mcr &= ~(XMAC_MCR_FORCE_TX_FC | XMAC_MCR_FORCE_RX_FC |
+			 XMAC_MCR_TRX_DISABLE);
+		if (tx_pause)
+			mcr |= XMAC_MCR_FORCE_TX_FC;
+		if (rx_pause)
+			mcr |= XMAC_MCR_FORCE_RX_FC;
 
-	mtk_w32(mac->hw, mcr, MTK_XMAC_MCR(mac->id));
+		mtk_w32(mac->hw, mcr, MTK_XMAC_MCR(mac->id));
+	}
 }
 
 static void mtk_mac_link_up(struct phylink_config *config,

From af787a31f2d498cb09067d2dfd7d2c81c4cbaacf Mon Sep 17 00:00:00 2001
From: Mason Chang <mason-cw.chang@mediatek.com>
Date: Thu, 10 Sep 2026 14:52:00 +0800
Subject: [PATCH] net: ethernet: mtk_eth_soc: fix memory leak on page pool creation failure

If mtk_create_page_pool() fails, ring->data allocated via kcalloc()
was not freed before returning the error, causing a memory leak.

Link: https://github.com/mediatek/mtk-openwrt-feeds/blob/671c2416d6219beb19abbb05709e418a6363be62/25.12/files/target/linux/mediatek/patches-6.12/999-eth-55-fix-memory-leak-on-page-pool-creation-failure.patch
Signed-off-by: Paul-Louis Charrière <plcharriere@gmail.com>
---
 drivers/net/ethernet/mediatek/mtk_eth_soc.c | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -3108,8 +3108,11 @@ static int mtk_rx_alloc(struct mtk_eth *
 
 		pp = mtk_create_page_pool(eth, &ring->xdp_q, ring_no,
 					  rx_dma_size);
-		if (IS_ERR(pp))
+		if (IS_ERR(pp)) {
+			kfree(ring->data);
+			ring->data = NULL;
 			return PTR_ERR(pp);
+		}
 
 		ring->page_pool = pp;
 	}

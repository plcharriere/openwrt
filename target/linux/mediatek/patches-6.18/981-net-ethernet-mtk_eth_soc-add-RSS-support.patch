+/* With RSS the RX rings are polled concurrently.  Each ring owns its Net DIM
+ * counters, and one ring at a time feeds their sum to the shared Net DIM
+ * context.
+ */
+static void mtk_rx_dim_update(struct mtk_eth *eth, struct mtk_napi *rx_napi,
+			      int done, int bytes)
+{
+	struct dim_sample dim_sample = {};
+	u32 events = 0, packets = 0;
+	u32 rx_bytes = 0;
+	int i;
+
+	WRITE_ONCE(rx_napi->rx_packets, rx_napi->rx_packets + done);
+	WRITE_ONCE(rx_napi->rx_bytes, rx_napi->rx_bytes + bytes);
+
+	if (!spin_trylock(&eth->rx_dim_lock))
+		return;
+
+	for (i = 0; i < mtk_rx_napi_num(eth); i++) {
+		events += READ_ONCE(eth->rx_napi[i].rx_events);
+		packets += READ_ONCE(eth->rx_napi[i].rx_packets);
+		rx_bytes += READ_ONCE(eth->rx_napi[i].rx_bytes);
+	}
+	dim_update_sample(events, packets, rx_bytes, &dim_sample);
+	net_dim(&eth->rx_dim, &dim_sample);
+
+	spin_unlock(&eth->rx_dim_lock);
+}

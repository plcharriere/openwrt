+/* All MACs share the RX rings, so the RSS settings apply to every port */
+static int mtk_set_rxfh(struct net_device *dev, struct ethtool_rxfh_param *rxfh,
+			struct netlink_ext_ack *extack)
+{
+	struct mtk_mac *mac = netdev_priv(dev);
+	struct mtk_eth *eth = mac->hw;
+	int i;
+
+	if (!eth->rss_num)
+		return -EOPNOTSUPP;
+
+	if (rxfh->hfunc != ETH_RSS_HASH_NO_CHANGE &&
+	    rxfh->hfunc != ETH_RSS_HASH_TOP)
+		return -EOPNOTSUPP;
+
+	if (rxfh->indir)
+		for (i = 0; i < MTK_RSS_MAX_INDIRECTION_TABLE; i++)
+			if (rxfh->indir[i] >= eth->rss_num)
+				return -EINVAL;
+
+	if (rxfh->key)
+		memcpy(eth->rss_params.hash_key, rxfh->key,
+		       MTK_RSS_HASH_KEYSIZE);
+	if (rxfh->indir)
+		for (i = 0; i < MTK_RSS_MAX_INDIRECTION_TABLE; i++)
+			eth->rss_params.indirection_table[i] = rxfh->indir[i];
+
+	/* Otherwise mtk_rss_init() programs them when the DMA starts */
+	if (refcount_read(&eth->dma_refcnt))
+		mtk_rss_update(eth);
+
+	return 0;

+static void mtk_napi_init(struct mtk_eth *eth)
+{
+	struct mtk_rss_params *rss_params = &eth->rss_params;
+	int i;
+
+	for (i = 0; i < MTK_RX_NAPI_NUM; i++) {
+		struct mtk_napi *rx_napi = &eth->rx_napi[i];
+
+		rx_napi->eth = eth;
+		rx_napi->rx_ring = &eth->rx_ring[i];
+		rx_napi->irq_done_mask = eth->rss_num ?
+					 MTK_RX_DONE_INT_RSS(i) :
+					 eth->soc->rx.irq_done_mask;
+	}
+
+	if (!eth->rss_num)
+		return;
+
+	netdev_rss_key_fill(rss_params->hash_key, sizeof(rss_params->hash_key));
+	for (i = 0; i < MTK_RSS_MAX_INDIRECTION_TABLE; i++)
+		rss_params->indirection_table[i] =
+			ethtool_rxfh_indir_default(i, eth->rss_num);
+}
+
+static int mtk_request_rss_irqs(struct mtk_eth *eth)
+{
+	int i, err;
+
+	for (i = 0; i < eth->rss_num; i++) {
+		const char *name;
+
+		name = devm_kasprintf(eth->dev, GFP_KERNEL, "%s-rx%d",
+				      dev_name(eth->dev), i);
+		if (!name)
+			return -ENOMEM;
+
+		err = devm_request_irq(eth->dev, eth->irq_pdma[i],
+				       mtk_handle_irq_rx, 0, name,
+				       &eth->rx_napi[i]);
+		if (err)
+			return err;
+
+		/* Spread the RX rings over the CPUs by default */
+		irq_set_affinity(eth->irq_pdma[i],
+				 cpumask_of(cpumask_local_spread(i, NUMA_NO_NODE)));
+	}
+
+	return 0;
+}

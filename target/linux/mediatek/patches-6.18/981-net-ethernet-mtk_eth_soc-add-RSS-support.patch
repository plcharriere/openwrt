+/* RSS needs one PDMA interrupt per RX ring, named pdma0 to pdma3.  Without
+ * them, e.g. with an older device tree, the SoC runs with a single RX ring.
+ */
+static int mtk_get_rss_irqs(struct platform_device *pdev, struct mtk_eth *eth)
+{
+	char name[] = "pdma0";
+	int i, irq;
+
+	eth->rss_num = 0;
+	if (!eth->soc->rss_num || MTK_HAS_CAPS(eth->soc->caps, MTK_HWLRO))
+		return 0;
+
+	if (WARN_ON(eth->soc->rss_num > MTK_PDMA_IRQ_NUM))
+		return 0;
+
+	for (i = 0; i < eth->soc->rss_num; i++) {
+		name[4] = '0' + i;
+		irq = platform_get_irq_byname_optional(pdev, name);
+		if (irq == -ENXIO) {
+			dev_info(&pdev->dev, "no %s interrupt, RSS disabled\n",
+				 name);
+			return 0;
+		}
+		if (irq < 0)
+			return dev_err_probe(&pdev->dev, irq,
+					     "Error requesting %s IRQ\n", name);
+
+		eth->irq_pdma[i] = irq;
+	}
+
+	eth->rss_num = eth->soc->rss_num;
+
+	return 0;
+}
+
+static int mtk_get_optional_irqs(struct platform_device *pdev,
+				 struct mtk_eth *eth)
+{
+	int err;
+
+	err = mtk_get_misc_irq(pdev, eth);
+	if (err)
+		return err;
+
+	return mtk_get_rss_irqs(pdev, eth);
+}

+static u32 mtk_rss_indr_table(const struct mtk_rss_params *rss_params,
+			      int index)
+{
+	u32 val = 0;
+	int i;
+
+	for (i = 16 * index; i < 16 * index + 16; i++)
+		val |= rss_params->indirection_table[i] << (2 * (i % 16));
+
+	return val;
+}
+
+/* Program the hash key and indirection table while RSS is paused */
+static void mtk_rss_update(struct mtk_eth *eth)
+{
+	const struct mtk_reg_map *reg_map = eth->soc->reg_map;
+	struct mtk_rss_params *rss_params = &eth->rss_params;
+	u32 val;
+	int i;
+
+	val = mtk_r32(eth, reg_map->pdma.rss_glo_cfg);
+	mtk_w32(eth, val | MTK_RSS_CFG_REQ, reg_map->pdma.rss_glo_cfg);
+
+	for (i = 0; i < MTK_RSS_HASH_KEYSIZE / sizeof(u32); i++)
+		mtk_w32(eth, rss_params->hash_key[i],
+			MTK_RSS_HASH_KEY_DW(reg_map, i));
+
+	for (i = 0; i < MTK_RSS_MAX_INDIRECTION_TABLE / 16; i++)
+		mtk_w32(eth, mtk_rss_indr_table(rss_params, i),
+			MTK_RSS_INDR_TABLE_DW(reg_map, i));
+
+	mtk_w32(eth, val & ~MTK_RSS_CFG_REQ, reg_map->pdma.rss_glo_cfg);
+}
+
+static void mtk_rss_init(struct mtk_eth *eth)
+{
+	const struct mtk_reg_map *reg_map = eth->soc->reg_map;
+	const u32 grp[] = {
+		reg_map->pdma.int_grp,		/* ring 1 */
+		reg_map->pdma.int_grp + 0x4,	/* ring 2 */
+		reg_map->pdma.int_grp3,		/* ring 3 */
+	};
+	u32 val;
+	int i;
+
+	val = mtk_r32(eth, reg_map->pdma.rss_glo_cfg);
+	val |= MTK_RSS_IPV4_STATIC_HASH | MTK_RSS_IPV6_STATIC_HASH;
+	mtk_w32(eth, val, reg_map->pdma.rss_glo_cfg);
+
+	mtk_rss_update(eth);
+
+	mtk_w32(eth, val | MTK_RSS_CFG_REQ, reg_map->pdma.rss_glo_cfg);
+	mtk_w32(eth, val | MTK_RSS_CFG_REQ | MTK_RSS_EN,
+		reg_map->pdma.rss_glo_cfg);
+	mtk_w32(eth, val | MTK_RSS_EN, reg_map->pdma.rss_glo_cfg);
+
+	/* Ring 0 stays in PDMA interrupt group 0; rings 1 to 3 use groups 1
+	 * to 3, raised on the pdma1 to pdma3 interrupts.
+	 */
+	for (i = 1; i < eth->rss_num; i++)
+		mtk_w32(eth, MTK_RX_DONE_INT_RSS(i), grp[i - 1]);
+}
+
+static void mtk_rss_uninit(struct mtk_eth *eth)
+{
+	const struct mtk_reg_map *reg_map = eth->soc->reg_map;
+	u32 val;
+
+	val = mtk_r32(eth, reg_map->pdma.rss_glo_cfg);
+	mtk_w32(eth, val | MTK_RSS_CFG_REQ, reg_map->pdma.rss_glo_cfg);
+	mtk_w32(eth, (val | MTK_RSS_CFG_REQ) & ~MTK_RSS_EN,
+		reg_map->pdma.rss_glo_cfg);
+	mtk_w32(eth, val & ~(MTK_RSS_CFG_REQ | MTK_RSS_EN),
+		reg_map->pdma.rss_glo_cfg);
+}

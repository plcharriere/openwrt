. /lib/functions.sh

[ "$(board_name)" = "glinet,gl-mt3600be" ] || exit 0

dns_rule_found=0

find_dns_rule() {
	local name

	config_get name "$1" name
	[ "$name" = "DNS-answers-VI" ] && dns_rule_found=1
}

config_load firewall
config_foreach find_dns_rule rule

[ "$dns_rule_found" -eq 0 ] || exit 0

uci -q batch > /dev/null <<-EOT
	add firewall rule
	set firewall.@rule[-1].name='DNS-answers-VI'
	set firewall.@rule[-1].proto='tcp udp'
	set firewall.@rule[-1].src_port='53'
	set firewall.@rule[-1].target='DSCP'
	set firewall.@rule[-1].set_dscp='CS5'
	commit firewall
EOT

exit 0
